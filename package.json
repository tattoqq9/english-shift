{
  "name": "english-shift-v01",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:debug": "vite --host 0.0.0.0 --mode debug",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "core:check": "tsc -p tsconfig.core.json && node .core-build/scripts/core-smoke.js && node .core-build/scripts/mastery-smoke.js && node .core-build/scripts/review-smoke.js",
    "grammar:audit": "tsc -p tsconfig.core.json && node .core-build/scripts/grammar-audit.js",
    "mastery:check": "tsc -p tsconfig.core.json && node .core-build/scripts/mastery-smoke.js",
    "review:check": "tsc -p tsconfig.core.json && node .core-build/scripts/review-smoke.js",
    "build:check": "tsc -p tsconfig.core.json && node .core-build/scripts/build-smoke.js",
    "nav:check": "tsc -p tsconfig.core.json && node .core-build/scripts/navigation-smoke.js",
    "advanced:check": "tsc -p tsconfig.core.json && node .core-build/scripts/advanced-smoke.js",
    "level2:audit": "tsc -p tsconfig.core.json && node .core-build/scripts/build-smoke.js",
    "level2:quality": "tsc -p tsconfig.core.json && node .core-build/scripts/build-quality-audit.js"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
